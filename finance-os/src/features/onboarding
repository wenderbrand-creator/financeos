/* ===== onboarding (welcome + first steps + one-time tips) ===== */
.wl-overlay{position:fixed;inset:0;z-index:150;display:grid;place-items:center;padding:24px max(16px,env(safe-area-inset-right,0px)) 24px max(16px,env(safe-area-inset-left,0px));
  background:color-mix(in srgb,var(--bg) 72%,transparent);backdrop-filter:blur(10px) saturate(1.2);-webkit-backdrop-filter:blur(10px) saturate(1.2);
  animation:wlFade .3s var(--ease) backwards;overflow-y:auto}
.wl-overlay.leaving{animation:wlFadeOut .22s ease forwards}
.wl-overlay.leaving .wl{animation:wlOut .22s ease forwards}
@keyframes wlFade{from{opacity:0}}
@keyframes wlFadeOut{to{opacity:0}}
@keyframes wlIn{from{opacity:0;transform:translateY(16px) scale(.98);filter:blur(4px)}}
@keyframes wlOut{to{opacity:0;transform:translateY(8px) scale(.985)}}
.wl{width:100%;max-width:600px;background:var(--surface);border:1px solid var(--line);border-radius:22px;
  box-shadow:0 2px 6px rgba(17,24,39,.06),0 32px 80px -24px rgba(17,24,39,.32);display:flex;flex-direction:column;max-height:calc(100dvh - 48px);
  animation:wlIn .55s cubic-bezier(.16,1,.3,1) .05s backwards}
.wl-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:20px 24px 0}
.wl-skipall{color:var(--text-2)}
.wl-skipall:hover{color:var(--text);background:var(--surface-2)}

.wl-progress{list-style:none;margin:18px 24px 0;padding:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:6px}
.wl-progress li{display:flex;flex-direction:column;gap:7px;min-width:0}
.wl-progress button{border:0;padding:4px 0;background:none;cursor:pointer;display:block;width:100%}
.wl-progress button:disabled{cursor:default}
.wl-progress i{display:block;height:4px;border-radius:2px;background:var(--sunken);position:relative;overflow:hidden}
.wl-progress i::after{content:"";position:absolute;inset:0;background:var(--accent);border-radius:2px;transform:scaleX(0);transform-origin:left;transition:transform .5s cubic-bezier(.16,1,.3,1)}
.wl-progress li.done i::after,.wl-progress li.on i::after{transform:scaleX(1)}
.wl-progress li.on i::after{opacity:.55}
.wl-progress span{font-size:11.5px;color:var(--text-3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;transition:color .2s}
.wl-progress li.on span{color:var(--text);font-weight:600}
.wl-progress li.done span{color:var(--text-2)}
.wl-progress li.done button:hover i::after{opacity:.8}

.wl-body{padding:26px 24px 8px;overflow-y:auto;overflow-x:hidden;flex:1}
.wl-step{display:flex;flex-direction:column;gap:18px}
.wl-step > *{min-width:0}
.wl-step.fwd{animation:wlStepF .38s cubic-bezier(.16,1,.3,1) backwards}
.wl-step.back{animation:wlStepB .38s cubic-bezier(.16,1,.3,1) backwards}
@keyframes wlStepF{from{opacity:0;transform:translateX(22px)}}
@keyframes wlStepB{from{opacity:0;transform:translateX(-22px)}}
.wl-title{margin:0;font-size:clamp(22px,2.4vw,27px);line-height:1.15;font-weight:650;letter-spacing:-.025em;text-wrap:balance}
.wl-lead{margin:-8px 0 2px;color:var(--text-2);font-size:14.5px;line-height:1.55;max-width:52ch}
.wl-big{height:50px!important;font-size:17px!important}

.wl-themes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.wl-preview{display:flex;gap:16px;align-items:center;padding:14px;border-radius:var(--r-lg);background:var(--surface-2);border:1px solid var(--line);flex-wrap:wrap}
.wl-pcard{width:190px;max-width:100%;aspect-ratio:1.586;border-radius:12px;padding:12px 14px;display:flex;flex-direction:column;justify-content:space-between;color:#fff;
  background:radial-gradient(120% 90% at 100% 0%,color-mix(in oklab,var(--accent-base) 70%,#fff) 0%,transparent 55%),color-mix(in oklab,var(--accent-base) 82%,#0b0c12);
  box-shadow:0 12px 24px -14px color-mix(in srgb,var(--accent-base) 80%,transparent);transition:background .4s,box-shadow .4s}
.wl-pcard span{font-size:12px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.wl-pcard b{font-size:18px;font-weight:650;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.wl-pcard i{display:block;height:4px;border-radius:2px;background:rgba(255,255,255,.22);overflow:hidden}
.wl-pcard em{display:block;height:100%;background:#fff;border-radius:2px}
.wl-pside{display:flex;flex-direction:column;align-items:flex-start;gap:10px}

.wl-choice{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.wl-opt{display:flex;flex-direction:column;align-items:flex-start;gap:4px;text-align:left;padding:14px 16px;border-radius:var(--r-lg);border:1px solid var(--line);background:var(--surface);cursor:pointer;
  transition:border-color .2s,box-shadow .25s,transform .3s cubic-bezier(.16,1,.3,1)}
.wl-opt svg{color:var(--text-3);margin-bottom:4px;transition:color .2s}
.wl-opt b{font-size:14.5px;font-weight:600}
.wl-opt span{font-size:12.5px;color:var(--text-3)}
.wl-opt:hover{border-color:var(--line-strong)}
.wl-opt.on{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
.wl-opt.on svg{color:var(--accent-ink)}
.wl-cardform{display:flex;flex-direction:column;gap:14px;animation:enter .35s cubic-bezier(.16,1,.3,1) backwards}

.wl-paths{display:flex;flex-direction:column;gap:10px}
.wl-path{display:grid;grid-template-columns:42px minmax(0,1fr) 18px;gap:14px;align-items:center;text-align:left;padding:14px 16px;border-radius:var(--r-lg);border:1px solid var(--line);background:var(--surface);cursor:pointer;
  transition:border-color .2s,box-shadow .25s,transform .25s cubic-bezier(.16,1,.3,1),background .2s}
.wl-path > span:nth-child(2){display:flex;flex-direction:column;gap:2px;min-width:0}
.wl-path b{font-size:14.5px;font-weight:600}
.wl-path span span{font-size:12.5px;color:var(--text-3);line-height:1.45}
.wl-path > svg{color:var(--text-3);transition:transform .25s cubic-bezier(.16,1,.3,1),color .2s}
.wl-path:hover{border-color:var(--accent-line);background:color-mix(in srgb,var(--accent-soft) 40%,var(--surface))}
.wl-path:hover > svg{transform:translateX(3px);color:var(--accent-ink)}
.wl-path:active{transform:scale(.99)}
.wl-path:disabled{opacity:.6;cursor:wait}
.wl-pico{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;background:var(--accent-soft);color:var(--accent-ink)}

.wl-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:16px 24px 20px;border-top:1px solid var(--line);margin-top:12px}
.wl-foot-r{display:flex;gap:8px;align-items:center}

/* first steps */
.fs{padding:18px var(--pad)}
.fs-head{display:flex;align-items:center;gap:16px}
.fs-head > div:first-child{flex-shrink:0}
.fs-bar{flex:1;height:6px;border-radius:3px;background:var(--sunken);overflow:hidden;max-width:260px;margin-left:auto}
.fs-bar i{display:block;height:100%;background:var(--accent);border-radius:3px;transition:width .6s cubic-bezier(.16,1,.3,1)}
.fs-list{list-style:none;margin:14px 0 0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 24px}
.fs-list li{display:grid;grid-template-columns:20px minmax(0,1fr) auto;gap:12px;align-items:center;padding:10px 0;border-top:1px solid var(--line)}
.fs-check{width:20px;height:20px;border-radius:50%;border:1.5px solid var(--line-strong);display:grid;place-items:center;color:var(--on-accent);transition:background .3s,border-color .3s}
.fs-list li.done .fs-check{background:var(--pos);border-color:var(--pos);color:#fff;animation:pop .4s cubic-bezier(.16,1,.3,1)}
.fs-text{display:flex;flex-direction:column;min-width:0}
.fs-text b{font-size:13.5px;font-weight:550}
.fs-text span{font-size:12px;color:var(--text-3)}
.fs-list li.done .fs-text b{color:var(--text-3);text-decoration:line-through;text-decoration-color:var(--line-strong)}
.once-tip{margin-bottom:16px;align-items:center}

@media (max-width:760px){
  .wl-overlay{place-items:end stretch;padding:0;backdrop-filter:none;-webkit-backdrop-filter:none;background:var(--overlay)}
  .wl{max-width:none;border-radius:22px 22px 0 0;max-height:100dvh;height:100dvh;border-bottom:0;animation:sheet .4s var(--ease) backwards}
  .wl-head{padding:calc(16px + env(safe-area-inset-top,0px)) 18px 0}
  .wl-progress{margin:16px 18px 0}
  .wl-progress span{display:none}
  .wl-body{padding:22px 18px 8px}
  .wl-themes{grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
  .wl-themes .theme-opt .lbl{font-size:12px;gap:5px}
  .wl-themes .mini{height:58px}
  .wl-choice{grid-template-columns:1fr}
  .wl-foot{padding:12px 18px calc(14px + env(safe-area-inset-bottom,0px));flex-wrap:wrap}
  .wl-foot-r{flex:1;justify-content:flex-end}
  .fs-list{grid-template-columns:minmax(0,1fr)}
  .fs-bar{display:none}
  .fs-head .btn{margin-left:auto}
}
