{
  "name": "finance-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Finance OS — gestão financeira pessoal (React + Vite + TypeScript + Supabase)",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postbuild": "node scripts/check-bundle.mjs",
    "test:db": "node supabase/tests/rls.test.mjs",
    "test:all": "vitest run && node supabase/tests/rls.test.mjs"
  },
  "dependencies": {
    "@fontsource/geist-mono": "5.1.0",
    "@fontsource/geist-sans": "5.1.0",
    "@supabase/supabase-js": "2.117.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
